<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Meeting Room Provisioning" Height="720" Width="1040"
    WindowStartupLocation="CenterScreen"
    Background="#F5F7FA" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2D6CDF"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1F4FB0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2933"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#697586"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#D7DCE3"/>
        <SolidColorBrush x:Key="StepInactiveBrush" Color="#9AA5B1"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E5A"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#0E7490"/>
        <SolidColorBrush x:Key="InfoBoxBackgroundBrush" Color="#EAF6FB"/>
        <SolidColorBrush x:Key="InfoBoxBorderBrush" Color="#BEE3F0"/>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B7C3D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECEFF3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SmallButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="H1">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Sub">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="StepLabel">
            <Setter Property="Foreground" Value="{StaticResource StepInactiveBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Collapsed-by-default "what does this actually do" explainer.
             Deliberately the stock Expander control (no custom
             ControlTemplate) rather than a hand-styled toggle - this app has
             no design-time preview, and the built-in glyph/chrome is a safer
             bet than a from-scratch template that can only be checked by
             actually opening the window. Only the header text and the
             content box underneath are styled. -->
        <Style TargetType="Expander" x:Key="InfoExpander">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoExpanderHeader">
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Border" x:Key="InfoBox">
            <Setter Property="Background" Value="{StaticResource InfoBoxBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InfoBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="InfoBoxText">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left step rail -->
        <Border Grid.Row="0" Grid.Column="0" Background="#101828">
            <StackPanel Margin="24,32,24,0">
                <TextBlock Text="Meeting Room" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Provisioning" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,28"/>
                <TextBlock x:Name="lblStep1" Text="1. Connect" Style="{StaticResource StepLabel}" Foreground="White"/>
                <TextBlock x:Name="lblStepMode" Text="2. Mode" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStep2" Text="3. Room List" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStep3" Text="4. Security Group" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStepSspr" Text="5. SSPR Exclusion" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStep4" Text="6. Rooms &amp; Domain" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStep5" Text="7. Place Info" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStep6" Text="8. Calendar Settings" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
                <TextBlock x:Name="lblStep7" Text="9. Review &amp; Create" Style="{StaticResource StepLabel}" Foreground="#8CA0C4"/>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="36,32,36,16">

            <!-- STEP 1: Connect -->
            <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Connect to your tenant" Style="{StaticResource H1}"/>
                    <TextBlock Text="Signs in once to Exchange Online and once to Microsoft Graph. Both sessions stay open for the rest of the wizard." Style="{StaticResource Sub}"/>
                    <Button x:Name="btnConnect" Content="Connect" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Width="160"/>
                    <TextBlock x:Name="txtConnectStatus" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,20,0,0" Visibility="Collapsed" x:Name="LicenseInfoCard">
                        <StackPanel>
                            <TextBlock Text="Existing room mailbox licenses" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtLicenseInfo" TextWrapping="Wrap" Foreground="{StaticResource InfoBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP Mode: Create vs Edit -->
            <ScrollViewer x:Name="StepModePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="What do you want to do?" Style="{StaticResource H1}"/>
                    <TextBlock Text="Create sets up brand-new meeting rooms end to end. Edit lets you change settings - calendar processing, place info, Room List, password - on rooms that already exist." Style="{StaticResource Sub}"/>

                    <RadioButton x:Name="radModeCreate" Content="Create new rooms" GroupName="ModeChoice" IsChecked="True" Margin="0,0,0,10"/>
                    <RadioButton x:Name="radModeEdit" Content="Edit existing rooms" GroupName="ModeChoice" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 2: Room List -->
            <ScrollViewer x:Name="Step2Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Room List" Style="{StaticResource H1}"/>
                    <TextBlock Text="Pick an existing Room List to add these rooms to, or create a new one - its email address is generated automatically using the tenant's default domain." Style="{StaticResource Sub}"/>

                    <Expander Style="{StaticResource InfoExpander}">
                        <Expander.Header>
                            <TextBlock Text="What is a Room List, technically?" Style="{StaticResource InfoExpanderHeader}"/>
                        </Expander.Header>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock Style="{StaticResource InfoBoxText}" Text="A Room List is a distribution group (RecipientTypeDetails = RoomList) whose only members are room mailboxes. Outlook's and Teams' scheduling assistant use it purely to group related rooms - typically all rooms in one building or floor - so the room picker shows a manageable, relevant set instead of every room mailbox in the tenant. It has no effect on who can book a room, what settings apply to it, or how bookings are processed - Set-CalendarProcessing (see the Calendar processing step) governs all of that. A room mailbox can belong to at most one Room List at a time; adding it to a new one implicitly removes it from any other."/>
                        </Border>
                    </Expander>

                    <RadioButton x:Name="radSkipRoomList" Content="Don't change Room List membership" GroupName="RoomListChoice" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <RadioButton x:Name="radUseExistingRoomList" Content="Use an existing Room List" GroupName="RoomListChoice" IsChecked="True" Margin="0,0,0,8"/>
                    <ListBox x:Name="lstRoomLists" Height="160" Margin="20,0,0,16" DisplayMemberPath="Name"/>

                    <RadioButton x:Name="radCreateNewRoomList" Content="Create a new Room List" GroupName="RoomListChoice" Margin="0,0,0,8"/>
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Text="New Room List name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNewRoomListName" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtNewRoomListAddressPreview" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 3: CA exclusion group -->
            <ScrollViewer x:Name="Step3Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Conditional Access exclusion group" Style="{StaticResource H1}"/>
                    <TextBlock Text="Meeting rooms shouldn't be subject to Conditional Access (MFA etc.). Pick a group that's already excluded from at least one CA policy, or create a new one - a new group will automatically be excluded from every existing CA policy." Style="{StaticResource Sub}"/>

                    <Expander Style="{StaticResource InfoExpander}">
                        <Expander.Header>
                            <TextBlock Text="Why does a meeting room need to be excluded from Conditional Access?" Style="{StaticResource InfoExpanderHeader}"/>
                        </Expander.Header>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock Style="{StaticResource InfoBoxText}" Text="Conditional Access (CA) policies commonly require MFA, a compliant device, or a specific network location before sign-in succeeds. A room account is a shared, unattended resource - nobody is sitting at it to approve an MFA prompt or enroll it as a compliant device - so a CA policy that applies to it will simply block it from signing in, breaking the Teams Rooms app on that hardware. Adding the room account to a group listed in a policy's Users &gt; Exclude condition makes that specific policy skip evaluation for this account entirely, while every other account the policy is meant to protect is unaffected. This tool keeps the group excluded from every CA policy that exists at the time you run it - not just the ones present when the group was first created - so a policy someone adds later doesn't silently start blocking your rooms again."/>
                        </Border>
                    </Expander>

                    <RadioButton x:Name="radUseExistingCAGroup" Content="Use an existing excluded group" GroupName="CAGroupChoice" IsChecked="True" Margin="0,0,0,8"/>
                    <ListBox x:Name="lstCAGroups" Height="160" Margin="20,0,0,16" DisplayMemberPath="DisplayName"/>

                    <RadioButton x:Name="radCreateNewCAGroup" Content="Create a new group" GroupName="CAGroupChoice" Margin="0,0,0,8"/>
                    <StackPanel Margin="20,0,0,0">
                        <TextBlock Text="New group name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNewCAGroupName" Width="320" HorizontalAlignment="Left" Text="Meeting Rooms"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP SSPR: Self-Service Password Reset exclusion (both modes) -->
            <ScrollViewer x:Name="StepSsprPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Self-Service Password Reset (SSPR) exclusion" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="txtSsprStatus" Style="{StaticResource Sub}"/>

                    <Expander Style="{StaticResource InfoExpander}">
                        <Expander.Header>
                            <TextBlock Text="What is the 'SSPR Users' group, and what does its rule actually mean?" Style="{StaticResource InfoExpanderHeader}"/>
                        </Expander.Header>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock Style="{StaticResource InfoBoxText}" TextWrapping="Wrap">
                                <Run Text="Self-Service Password Reset lets a user reset their own forgotten password without calling the helpdesk. A room mailbox has no human owner who would ever go through that flow - if SSPR's scope covers room accounts (the default when it's scoped to &quot;All&quot;), the account is exposed to a self-service workflow it can never legitimately use, for no benefit. Excluding rooms from SSPR removes them from a process that was never meant to apply to them."/>
                                <LineBreak/><LineBreak/>
                                <Run Text="The dynamic membership rule works by defining who SHOULD be covered by SSPR (real, licensed employees) and then carving specific rooms back out:"/>
                                <LineBreak/>
                                <Run Text="• (user.assignedPlans -any (assignedPlan.servicePlanId -ne &quot;&quot; and assignedPlan.capabilityStatus -eq &quot;Enabled&quot;)) - matches any account with at least one currently-enabled licensed service plan, i.e. a real, licensed user rather than an unlicensed resource account."/>
                                <LineBreak/>
                                <Run Text="• (user.userType -eq &quot;Member&quot;) - excludes external Guest accounts."/>
                                <LineBreak/>
                                <Run Text="• (user.accountEnabled -eq true) - excludes disabled/offboarded accounts."/>
                                <LineBreak/>
                                <Run Text="• (user.userPrincipalName -ne &quot;room@yourdomain.com&quot;) - one such clause per room, appended automatically by this tool every time a room is created or edited, carving that exact sign-in address back out of the group."/>
                                <LineBreak/><LineBreak/>
                                <Run Text="Because it's a dynamic group, Entra re-evaluates membership automatically as accounts change - nobody has to manually add or remove members. Microsoft Graph has no API to read or set which group SSPR is actually scoped to, so creating this group is only half the job - see the note below about setting the scope yourself."/>
                            </TextBlock>
                        </Border>
                    </Expander>

                    <StackPanel x:Name="SsprDisabledPanel" Visibility="Collapsed">
                        <TextBlock Text="Nothing to do here - SSPR is not enabled in this tenant." Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <StackPanel x:Name="SsprGroupFoundPanel" Visibility="Collapsed">
                        <TextBlock Text="An 'SSPR Users' group already exists in this tenant. Every room processed in this run will automatically be added to its exclusion rule - no action needed here." Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <StackPanel x:Name="SsprGroupMissingPanel" Visibility="Collapsed">
                        <TextBlock Text="No 'SSPR Users' group was found in this tenant." Style="{StaticResource Sub}"/>
                        <CheckBox x:Name="chkCreateSsprGroup" Content="Create the 'SSPR Users' dynamic group now" Margin="0,10,0,8"/>
                        <TextBlock Text="Membership rule: licensed, active, Member-type accounts, with each meeting room excluded by name as it's created or edited. Microsoft Graph has no API to read or set which group SSPR is actually scoped to, so after creating this group you still need to go set it yourself in the Entra admin center (Password reset &gt; Properties) - this tool can't do that part." Style="{StaticResource Sub}" FontStyle="Italic" Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 4: Room names + domain (Create), or room selection (Edit) -->
            <ScrollViewer x:Name="Step4Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <StackPanel x:Name="CreateRoomNamingPanel">
                        <TextBlock Text="Meeting room names" Style="{StaticResource H1}"/>
                        <TextBlock Text="Type a room name and press Enter (or Add) to add it to the list. Repeat for each room." Style="{StaticResource Sub}"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtRoomNameInput" Width="320"/>
                            <Button x:Name="btnAddRoomName" Content="Add" Style="{StaticResource SmallButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="lstRoomNames" Height="150" Width="360" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <Button x:Name="btnRemoveRoomName" Content="Remove selected" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        <TextBlock Text="Domain for the new room accounts" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbDomain" Width="320" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel x:Name="EditRoomSelectionPanel" Visibility="Collapsed">
                        <TextBlock Text="Select rooms to edit" Style="{StaticResource H1}"/>
                        <TextBlock Text="Ctrl+click or shift+click to select more than one existing room mailbox." Style="{StaticResource Sub}"/>
                        <ListBox x:Name="lstExistingRooms" Height="300" Width="420" HorizontalAlignment="Left" SelectionMode="Extended" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 5: Place info -->
            <ScrollViewer x:Name="Step5Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Place information" Style="{StaticResource H1}"/>
                    <TextBlock Text="Applied to every room via Set-Place. Leave any field blank to skip it - blank fields are left out of the command instead of being sent as empty, so for existing rooms a blank field simply leaves that value unchanged." Style="{StaticResource Sub}"/>

                    <Expander Style="{StaticResource InfoExpander}">
                        <Expander.Header>
                            <TextBlock Text="What does Set-Place actually do?" Style="{StaticResource InfoExpanderHeader}"/>
                        </Expander.Header>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock Style="{StaticResource InfoBoxText}" Text="Set-Place writes structured location metadata onto the room mailbox's directory object (technically a 'place' object layered on top of it) - which building it's in, its street address, floor/capacity, and so on. None of this is required for the room to actually function as a bookable resource - the mailbox itself and Set-CalendarProcessing (see the Calendar processing step) handle accepting and scheduling meetings regardless of whether Set-Place has ever been run. What this data drives is the 'Room finder' / Places experience in Outlook and Teams: nearby-room suggestions, building maps, and capacity-aware filtering when someone is choosing where to book a meeting. In a tenant with only a handful of rooms this is barely noticeable; once there are rooms spread across multiple buildings or floors, it's the only thing that makes the room picker organized instead of a flat, unlabelled list."/>
                        </Border>
                    </Expander>

                    <TextBlock Text="Building" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtBuilding" Width="320" HorizontalAlignment="Left"/>
                    <TextBlock Text="Capacity" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCapacity" Width="320" HorizontalAlignment="Left"/>
                    <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCity" Width="320" HorizontalAlignment="Left"/>
                    <TextBlock Text="Postal code" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPostalCode" Width="320" HorizontalAlignment="Left"/>
                    <TextBlock Text="State / Region" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtState" Width="320" HorizontalAlignment="Left"/>
                    <TextBlock Text="Street" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtStreet" Width="320" HorizontalAlignment="Left"/>
                    <TextBlock Text="Country" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbCountry" Width="320" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Code"/>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 6: Calendar processing -->
            <ScrollViewer x:Name="Step6Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Calendar processing" Style="{StaticResource H1}"/>
                    <TextBlock Text="Standard mode uses the same defaults the tool always used. Custom mode asks a few plain-language questions and works out the right settings for you." Style="{StaticResource Sub}"/>

                    <Expander Style="{StaticResource InfoExpander}">
                        <Expander.Header>
                            <TextBlock Text="What is calendar processing, and why does it matter this much?" Style="{StaticResource InfoExpanderHeader}"/>
                        </Expander.Header>
                        <Border Style="{StaticResource InfoBox}">
                            <TextBlock Style="{StaticResource InfoBoxText}" Text="Every room mailbox runs its own automatic booking agent - the Calendar Attendant / Resource Booking Assistant - that decides, with no human involved, whether to accept or decline each meeting request sent to it. Set-CalendarProcessing configures that agent's entire rulebook: how far into the future it will accept bookings, whether it allows two meetings to overlap (and by how much) instead of auto-declining the second one, whether a designated person has to approve requests instead of them being auto-accepted, and what happens to a meeting's visible details (subject, organizer, attachments) once it lands on the room's calendar. Because nobody is actively monitoring a room mailbox's inbox the way they would their own, these settings ARE the room's entire booking behavior - get them wrong and it either silently rejects legitimate bookings or double-books itself with no one noticing until two teams show up to the same room."/>
                        </Border>
                    </Expander>

                    <RadioButton x:Name="radSkipCalendar" Content="Don't change calendar processing" GroupName="CalendarModeChoice" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <RadioButton x:Name="radStandardMode" Content="Standard mode (recommended defaults)" GroupName="CalendarModeChoice" IsChecked="True" Margin="0,0,0,8"/>
                    <RadioButton x:Name="radCustomMode" Content="Custom mode" GroupName="CalendarModeChoice" Margin="0,0,0,8"/>

                    <StackPanel x:Name="CustomCalendarPanel" Margin="20,10,0,0" Visibility="Collapsed">

                        <CheckBox x:Name="chkIsPrivate" Content="Is this a private meeting room? (hides subject/comments from the room calendar)" Margin="0,6,0,0"/>

                        <CheckBox x:Name="chkAllowConflictingSeries" Content="Still book a recurring series even if some occurrences conflict?" Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Conflict % allowed" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtConflictPercentage" Width="100" Text="30"/>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="Max conflicting instances" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtMaxConflictInstances" Width="100" Text="10"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="How far ahead should this room be bookable?" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbBookingWindow" Width="320" HorizontalAlignment="Left">
                            <ComboBoxItem Content="6 months (180 days)" Tag="180" IsSelected="True"/>
                            <ComboBoxItem Content="1 year (365 days)" Tag="365"/>
                            <ComboBoxItem Content="2 years (730 days)" Tag="730"/>
                            <ComboBoxItem Content="Custom" Tag="custom"/>
                        </ComboBox>
                        <TextBox x:Name="txtBookingWindowCustomDays" Width="140" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/>

                        <CheckBox x:Name="chkRequireApproval" Content="Should bookings require approval from a delegate instead of auto-accepting?" Margin="0,14,0,0"/>
                        <StackPanel Margin="20,6,0,0">
                            <TextBlock Text="Approver email address(es), comma-separated" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtApprovalDelegates" Width="400" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <CheckBox x:Name="chkAllowRecurring" Content="Allow recurring meeting series to be booked?" IsChecked="True" Margin="0,14,0,0"/>
                        <CheckBox x:Name="chkRemoveAttachments" Content="Strip attachments from meeting invites (saves mailbox space)?" IsChecked="True" Margin="0,10,0,0"/>
                        <CheckBox x:Name="chkAllowExternalRequests" Content="Accept meeting requests from people outside the organization?" IsChecked="True" Margin="0,10,0,0"/>
                        <CheckBox x:Name="chkRemovePrivateFlag" Content="Remove the 'Private' flag so others can see booking details normally?" Margin="0,10,0,0"/>

                        <TextBlock Text="Custom auto-reply text (leave blank for none)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtAdditionalResponseText" Width="400" HorizontalAlignment="Left" Text="This is a Microsoft Teams Meeting room!"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 7: Review + Create -->
            <ScrollViewer x:Name="Step7Panel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock x:Name="txtReviewHeading" Text="Review &amp; create" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="txtReviewSub" Text="Everything below will be applied to each room you added." Style="{StaticResource Sub}"/>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <TextBlock x:Name="txtReviewSummary" TextWrapping="Wrap"/>
                    </Border>

                    <CheckBox x:Name="chkResetPassword" Content="Reset password for these rooms" Margin="0,14,0,0" Visibility="Collapsed"/>

                    <StackPanel x:Name="PasswordEntryPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock Text="Room password (used for every room in this run)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Not saved between runs - you'll be asked to set it again next time you use this tool." Style="{StaticResource Sub}" FontStyle="Italic"/>
                        <PasswordBox x:Name="pwdRoomPassword" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <PasswordBox x:Name="pwdRoomPasswordConfirm" Width="320" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="btnCreate" Content="Create Rooms" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Width="180"/>
                        <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="120" Margin="10,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="txtProgressStatus" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="progRetry" Height="10" Minimum="0" Maximum="1" Value="0"/>
                    </StackPanel>

                    <TextBlock Text="Run log" Style="{StaticResource FieldLabel}"/>
                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="#0F172A" CornerRadius="4">
                        <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto" x:Name="LogScrollViewer">
                            <TextBlock x:Name="txtLog" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="12" Padding="10" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <Border Background="#EAF7EF" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0" Visibility="Collapsed" x:Name="ResultCard">
                        <StackPanel>
                            <TextBlock x:Name="txtResultHeading" Text="Done" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtResultPassword" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtResultLicenseReminder" TextWrapping="Wrap" FontStyle="Italic"/>
                            <TextBlock x:Name="txtResultSsprReminder" TextWrapping="Wrap" FontStyle="Italic" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom nav -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <Grid Margin="36,10,36,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtGlobalError" Grid.Column="0" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="btnBack" Grid.Column="1" Content="Back" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0"/>
                <Button x:Name="btnNext" Grid.Column="2" Content="Next" Style="{StaticResource PrimaryButton}" Width="110"/>
            </Grid>
        </Border>
    </Grid>
</Window>
